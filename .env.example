# Copy to .env.local and fill in. Never commit real values.

# Signs session cookies and comparisons. Use a long random string (at least 16 characters).
# Changing it signs everyone out and means existing drafts must be recompared before apply.
SESSION_SECRET=

# --- Sign-in (Supabase Auth) --------------------------------------------------------------------
# Flow: /signup → verification email → /auth/set-password → that password is used on /login.
# In Supabase → Authentication → URL Configuration, set Site URL to your app and add
#   https://<your-host>/auth/set-password
# to Redirect URLs. Project URL: Project Settings → Data API.
SUPABASE_URL=
# Publishable/anon key: Project Settings → API Keys → anon / publishable (server-only here).
SUPABASE_ANON_KEY=

# Optional fallback: shared team password when Supabase Auth is not set, or for smoke scripts
# that POST { password } without an email. Prefer removing this once everyone has an account.
APP_PASSWORD=

# Secret key for shared storage (drafts, settings, …). Server only — never NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → secret (sb_secret_…) or legacy service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Spira site URL, for example https://yourcompany.spiraservice.net (the REST path is added for you).
SPIRA_BASE_URL=

# Spira user the server acts as. Use a dedicated service account that can view the
# project and edit its test sets, nothing more.
SPIRA_USERNAME=

# That user's API key (Spira calls it the RSS token): My Profile → RSS token. Include the { } braces.
SPIRA_API_KEY=

# Optional. Google Gemini API key (https://aistudio.google.com/apikey) for the AI review of
# not-implemented keywords. Only test scenario names and keywords are sent. Leave empty to turn it off.
GEMINI_API_KEY=

# Optional. Gemini model for the AI review. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
